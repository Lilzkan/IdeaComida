{
  "expo": {
    "name": "IdeaComida",
    "slug": "ideacomida",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ideacomida",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ideacomida.app"
    },
    "android": {
      "package": "com.ideacomida.app"
    },
    "web": {
      "bundler": "metro",
      "name": "IdeaComida",
      "shortName": "IdeaComida",
      "display": "standalone",
      "themeColor": "#FF8FA3",
      "backgroundColor": "#FFFFFF",
      "lang": "es"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
